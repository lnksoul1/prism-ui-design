#!/usr/bin/env sh
# pre-push hook: refuse to push when lint or unit tests fail.
# Install with: npm run hooks:install   (sets core.hooksPath to .githooks)
# Bypass with:  git push --no-verify
set -e

echo "🔎 pre-push: running lint + tests…"

if ! npm run lint; then
  echo "❌ pre-push: lint failed — push aborted (use --no-verify to override)"
  exit 1
fi

if ! npm test; then
  echo "❌ pre-push: tests failed — push aborted (use --no-verify to override)"
  exit 1
fi

echo "✅ pre-push: lint + tests passed"
