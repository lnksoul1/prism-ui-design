{
  "name": "ui-design-mcp-server",
  "version": "2.0.0",
  "description": "Prism — an MCP server for design work: generate design tokens, assemble pages from 40 component types, review them for accessibility and quality, and export to HTML/React/Vue/Svelte/CSS or DTCG tokens. Stdio-only, no dashboard.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "prism-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true}); require('fs').rmSync('.test-build',{recursive:true,force:true})\"",
    "lint": "eslint .",
    "smoke": "npm run build && node scripts/smoke-mcp.mjs",
    "check": "npm run lint && npm test",
    "hooks:install": "git config core.hooksPath .githooks",
    "hooks:uninstall": "git config --unset core.hooksPath",
    "test": "npm run build && tsc -p tsconfig.tests.json && node --test \".test-build/tests/*.test.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "js-yaml": "^5.2.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "playwright": "^1.64.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0"
  }
}
